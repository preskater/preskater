# dependencies (installed inside the image)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build output
.next
out
build

# prisma generated client (regenerated during the build)
src/generated

# env files: never bake secrets into the image (both .env and .env.prod)
.env*

# docker + compose definitions are not needed in the build context
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
compose*.yml
.dockerignore

# repo and editor metadata
.git
.gitignore
.gitattributes
.vscode
.idea
.github
*.swp
*.swo

# docs, agents and skills
*.md
AGENTS.md
.agents

# typescript / tooling caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
.cache
.turbo

# misc
coverage
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
