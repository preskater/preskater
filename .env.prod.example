# Production / docker compose stack environment.
# Copy to .env.prod and fill in the values before running
# `docker compose up --build`.

# Inside the compose network the database is reachable by its service name.
# Do NOT use localhost here: that would resolve to the app container itself.
DATABASE_URL="postgresql://preskater:preskater@db:5432/preskater"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Inlined into the client bundle at build time. Pass it as a build arg
# (`NEXT_PUBLIC_APP_URL=https://example.com docker compose build`) when
# deploying anywhere other than localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Password for administrator@preskater.com, used by the seed. Required: the
# seed fails if it is unset.
ADMINISTRATOR_PASSWORD=""
