# syntax=docker/dockerfile:1

# ============================================================
# Development image: runs `next dev` with a bind-mounted source tree.
# Compose overlays the app's volumes (see docker-compose.dev.yml); this image
# only provides the dependencies and the default command.
# ============================================================
ARG NODE_VERSION=24-alpine

FROM node:${NODE_VERSION} AS dev

WORKDIR /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

COPY . .

# prisma.config.ts resolves DATABASE_URL eagerly, so a placeholder is needed to
# generate the client at build time. The real URL is supplied by compose at
# runtime (docker-compose.dev.yml) and on container start.
RUN DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder" \
    npx prisma generate

EXPOSE 3000

# Regenerate the Prisma Client on start (it is gitignored and may be absent
# when the source tree is bind-mounted) and bind to all interfaces so the
# port is reachable from the host.
CMD ["sh", "-c", "npx prisma generate && npm run dev -- -H 0.0.0.0 -p 3000"]
